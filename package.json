{
  "name": "afograde-360-mentorship",
  "version": "1.0.0",
  "private": true,
  "description": "Official AFOGRADE 360+ Mentorship Series campaign landing page and registration workflow (5,000 Pacesetters Project).",
  "scripts": {
    "tokens:css": "node scripts/generate-tokens-css.js afograde-design-tokens.json src/styles/tokens.css",
    "predev": "npm run tokens:css",
    "dev": "next dev",
    "prebuild": "npm run tokens:css",
    "build": "next build && node scripts/verify-static-export.mjs",
    "start": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/tokens-and-contrast.test.ts tests/validation.test.ts tests/state-machine-and-persistence.test.ts tests/integrations-and-privacy.test.ts tests/api-flow.test.ts"
  },
  "dependencies": {
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "^8.5.32"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
