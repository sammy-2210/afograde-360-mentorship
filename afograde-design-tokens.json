    "easingEmphasized": "cubic-bezier(0.2, 0, 0, 1)",
    "reducedMotion": "Respect prefers-reduced-motion; remove non-essential transitions and parallax."
  },
  "accessibility": {
    "minimumBodyFontSize": "14px",
    "recommendedBodyFontSize": "16px",
    "minimumTouchTarget": "48px",
    "focusVisible": "Always provide a clearly visible keyboard focus indicator.",
    "contrast": "Verify every foreground/background pairing against WCAG 2.2 AA before release. Do not assume every curated color pairing automatically passes.",
    "forms": "Use persistent labels, inline error messages, clear required-field indicators, and programmatic field associations."
  },
  "implementation": {
    "cssVariablePrefix": "--afograde-",
    "recommendedFontImport": "https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap",
    "notes": [
      "Use semantic color roles in components rather than hardcoding hex values.",
      "Use the light scheme as the initial production theme; enable dark theme only when designed and tested end-to-end.",
      "The gradient is for selected brand moments such as the hero or CTA emphasis, not every section.",
      "Do not use elevation as the only way to communicate hierarchy; combine surface, spacing, and borders.",
      "Validate contrast for actual text sizes and states, including hover, disabled, error, and focus."
    ]
  }
}