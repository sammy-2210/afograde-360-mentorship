      "level1": "Subtle card separation",
      "level2": "Raised cards and menus",
      "level3": "Floating action elements and popovers",
      "level4": "Navigation drawers and prominent overlays",
      "level5": "Dialogs and highest-priority overlays"
    }
  },
  "components": {
    "button": {
      "heightSmall": "36px",
      "heightMedium": "40px",
      "heightLarge": "48px",
      "horizontalPadding": "24px",
      "cornerRadius": "{shape.full}",
      "primaryBackground": "{color.light.primary}",
      "primaryForeground": "{color.light.onPrimary}",
      "focusRing": "{color.light.tertiary}"
    },
    "input": {
      "minHeight": "56px",
      "cornerRadius": "{shape.extraSmall}",
      "border": "{color.light.outline}",
      "focusBorder": "{color.light.primary}",
      "background": "{color.light.surfaceContainerLowest}"
    },
    "card": {
      "cornerRadius": "{shape.large}",
      "background": "{color.light.surfaceContainerLow}",
      "elevation": "{elevation.level1}",
      "padding": "{spacing.layout.cardPadding}"
    },
    "navigation": {
      "desktopHeight": "72px",
      "mobileHeight": "64px",
      "background": "{color.light.surface}",
      "activeColor": "{color.light.primary}"
    }
