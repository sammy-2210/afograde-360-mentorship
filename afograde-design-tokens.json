  "elevation": {
    "level0": {
      "$value": "none",
      "$type": "shadow"
    },
    "level1": {
      "$value": [
        {
          "color": "#000000",
          "opacity": 0.08,
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        }
      ],
      "$type": "shadow"
    },
    "level2": {
      "$value": [
        {
          "color": "#000000",
          "opacity": 0.1,
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "6px",
          "spread": "0px"
        }
      ],
      "$type": "shadow"
    },
    "level3": {
      "$value": [
