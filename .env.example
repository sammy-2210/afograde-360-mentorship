# ==============================================================================
# AFOGRADE 360+ MENTORSHIP SERIES — PUBLIC ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `.env.local` for local development or configure these keys
# in Netlify -> Site configuration -> Environment variables.
#
# SECURITY RULE (PRD Section 15.2 & 18.3):
# Every `NEXT_PUBLIC_*` variable is embedded into the static client bundle.
# NEVER put private secrets (such as Cloudflare Turnstile Secret Key, Google
# Sheet credentials, or staff tokens) in any `.env*` file or repository.
# Store `TURNSTILE_SECRET_KEY` strictly inside Google Apps Script Properties.
# ==============================================================================

# Deployment environment: "preview" (default, sets noindex) | "production"
NEXT_PUBLIC_SITE_ENV=preview

# Canonical production origin (no trailing slash), e.g. https://360mentorship.afograde.com
# Leave blank until the official production domain is approved (GATE-INT-01).
NEXT_PUBLIC_SITE_URL=

# Deployed Google Apps Script Web App URL ending in /exec
# When empty, online form submission fails closed and presents WhatsApp fallback.
NEXT_PUBLIC_APPS_SCRIPT_URL=

# Cloudflare Turnstile public site key (paired with server-side Siteverify in Apps Script)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Privacy-gated Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Loaded ONLY when NEXT_PUBLIC_ANALYTICS_APPROVED="true" AND visitor grants consent.
NEXT_PUBLIC_ANALYTICS_APPROVED=false
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

